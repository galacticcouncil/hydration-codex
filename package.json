{
  "name": "hydration-codex",
  "version": "1.0.0",
  "description": "Living documentation system for Hydration Protocol",
  "type": "module",
  "scripts": {
    "extract": "tsx src/extract/index.ts",
    "extract:chain": "tsx src/extract/chain.ts",
    "extract:chain:baseline": "SAVE_BASELINE=true tsx src/extract/chain.ts",
    "extract:chain:local": "SOURCE=local tsx src/extract/chain.ts",
    "chopsticks": "npx @acala-network/chopsticks --config=chopsticks.yml",
    "extract:metadata": "tsx src/extract/metadata.ts",
    "extract:diagrams": "tsx src/extract/diagrams.ts",
    "extract:runtime": "tsx src/extract/runtime.ts",
    "extract:sdk": "tsx src/extract/sdk.ts",
    "extract:indexer": "tsx src/extract/indexer.ts",
    "extract:ui": "tsx src/extract/ui.ts",
    "extract:static:ui": "LAYER=ui tsx src/extract/static-analysis.ts",
    "extract:static:sdk": "LAYER=sdk tsx src/extract/static-analysis.ts",
    "extract:static": "npm run extract:static:ui && npm run extract:static:sdk",
    "extract:all": "npm run extract:runtime && npm run extract:sdk && npm run extract:indexer && npm run extract:ui && npm run extract:static",
    "synthesize": "tsx src/synthesize/index.ts",
    "synthesize:crossref": "EXTRACTIONS_PATH=./extractions OUTPUT_PATH=./docs-site/static tsx src/synthesize/crossref.ts",
    "synthesize:pallets": "EXTRACTIONS_PATH=./extractions OUTPUT_PATH=./docs-site/docs tsx src/synthesize/pallets.ts",
    "synthesize:sdk": "EXTRACTIONS_PATH=./extractions OUTPUT_PATH=./docs-site/docs tsx src/synthesize/sdk.ts",
    "synthesize:indexer": "EXTRACTIONS_PATH=./extractions OUTPUT_PATH=./docs-site/docs tsx src/synthesize/indexer.ts",
    "synthesize:hooks": "EXTRACTIONS_PATH=./extractions OUTPUT_PATH=./docs-site/docs tsx src/synthesize/hooks.ts",
    "synthesize:ai": "EXTRACTIONS_PATH=./extractions OUTPUT_PATH=./docs-site/static/ai tsx src/synthesize/ai-data.ts",
    "synthesize:all": "npm run synthesize:crossref && npm run synthesize:pallets && npm run synthesize:sdk && npm run synthesize:indexer && npm run synthesize:hooks && npm run synthesize:ai",
    "propose": "tsx src/propose/index.ts",
    "docs:build": "cd docs-site && npm run build",
    "docs:serve": "cd docs-site && npm run serve",
    "docs:dev": "cd docs-site && npm run start",
    "docs:full": "npm run extract:all && npm run synthesize:all && npm run docs:build",
    "docs:refresh": "npm run synthesize:all && npm run docs:build",
    "pipeline": "npm run extract && npm run synthesize && npm run propose",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "submodules:update": "./scripts/update-repos.sh",
    "submodules:status": "git submodule status"
  },
  "dependencies": {
    "@acala-network/chopsticks": "^1.1.1",
    "@polkadot/api": "^16.5.4",
    "@polkadot/types": "^16.5.4",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "date-fns": "^3.6.0",
    "fast-glob": "^3.3.0",
    "toml": "^3.0.0",
    "ts-morph": "^27.0.2",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
